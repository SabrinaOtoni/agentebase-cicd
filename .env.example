# Copie para .env e preencha. O .env NUNCA vai para o Git.
# Com o Azure OpenAI, infra/provisionar.sh gera o .env sozinho.

# Chave do provedor do modelo (Azure OpenAI, ou OpenAI direto).
OPENAI_API_KEY=coloque-sua-chave-aqui

# Azure OpenAI: https://<recurso>.openai.azure.com/openai/v1/ — vazio = OpenAI direto.
OPENAI_BASE_URL=

# Preenchido pelo Azure em cada ambiente (staging / production). Local fica "local".
# AMBIENTE=local
